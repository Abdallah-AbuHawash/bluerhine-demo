# Copy to .env.production ON THE SERVER and fill in. Never commit the result.
#   cp .env.production.example .env.production && nano .env.production

APP_NAME="CutToSize"
APP_ENV=production
APP_DEBUG=false
# Generate once:  docker run --rm php:8.5-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
# The URL the customer will open. Used for absolute links and asset URLs.
APP_URL=https://demo.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_DATABASE=cuttosize
DB_USERNAME=cuttosize
# Both required — compose refuses to start without them.
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- deployment -----------------------------------------------------------
# Host port for the demo. 127.0.0.1 keeps it private behind your reverse proxy;
# set DEMO_BIND=0.0.0.0 to serve it straight off the server IP instead.
DEMO_BIND=127.0.0.1
DEMO_PORT=8081

# Run migrations when the container boots.
MIGRATE_ON_BOOT=true
# true = wipe and re-seed demo data on every boot. Handy for a demo you want
# pristine; set false once the customer starts creating quotes you care about.
SEED_FRESH_ON_BOOT=true

# --- AI intake ------------------------------------------------------------
# Leave DEMO_OFFLINE=true to run on the canned fixtures with no key on the box.
DEMO_OFFLINE=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only for models that accept it (Opus / Sonnet 4.6+). Leave empty for Haiku.
ANTHROPIC_EFFORT=

# --- demo login -----------------------------------------------------------
# Seeded on every boot (SEED_FRESH_ON_BOOT). Set these for a hosted demo; the
# login form stops pre-filling credentials as soon as DEMO_USER_PASSWORD is set.
DEMO_USER_NAME="Suhaib"
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
