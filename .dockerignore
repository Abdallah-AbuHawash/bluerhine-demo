# Secrets must never be baked into an image layer.
.env
.env.*
!.env.example
!.env.production.example

# Rebuilt inside the image, or irrelevant to it.
.git
.gitignore
.github
node_modules
vendor
public/build
public/hot
public/storage
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Client-confidential source material — no reason for it to ship in an image.
CutToSize Phase1 Developer Brief.pdf
07_PS-1_drawings.html
08_PS-1_HDPE_companion_drawing.html

.DS_Store
.claude
